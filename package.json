{
  "name": "ugchooks-mcp",
  "version": "1.0.0",
  "description": "MCP connector for UGCHooks: create TikTok and Reels post batches from product links and read hooks, captions and hashtags.",
  "type": "module",
  "bin": {
    "ugchooks-mcp": "server/index.js"
  },
  "files": [
    "server",
    "icon.png",
    "manifest.json",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test test/*.test.mjs",
    "bundle": "mcpb pack . ugchooks.mcpb"
  },
  "dependencies": {
    "mcp-remote": "0.14.2"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Codex",
  "contributors": [
    {
      "name": "Codex"
    }
  ],
  "license": "MIT",
  "homepage": "https://ugchooks.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saeedmsdi-ugchooks/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/saeedmsdi-ugchooks/mcp-server/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ugchooks",
    "ugc",
    "tiktok",
    "instagram-reels",
    "social-media-content"
  ],
  "mcpName": "io.github.saeedmsdi-ugchooks/mcp-server",
  "overrides": {
    "tmp": "^0.2.6"
  }
}
